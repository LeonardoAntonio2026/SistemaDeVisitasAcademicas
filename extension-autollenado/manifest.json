{
  "manifest_version": 3,
  "name": "Autollenado · Visitas Académicas UTEZ",
  "version": "1.0.0",
  "description": "Llena el formulario de Nueva Solicitud con datos de prueba precargados.",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "http://161.153.57.186:8080/*"
      ],
      "js": ["src/presets.js", "src/autollenado.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Autollenar solicitud"
  }
}
