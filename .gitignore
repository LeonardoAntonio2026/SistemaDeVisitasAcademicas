# =========================================================================
# Apache Tomcat Specific Rules
# =========================================================================

# Ignore the build and deployment target directories
/target/
/work/
/temp/

# Ignore log directories generated during runtime
/logs/

# Ignore automatically extracted war files in webapps (if your source is inside webapps)
/webapps/ROOT/
/webapps/*.war
/webapps/*

# Exclude local server configurations containing secrets
/conf/Catalina/localhost/
/conf/tomcat-users.xml
/.claude/
/.hermes/
# Compiled class files
*.class

# Package Files
*.war
*.ear
*.jar

# Maven/Gradle outputs
/build/
.gradle/

/src/main/resources/
/.venv/

/docs/


*.crx
*.pem

# Entregables y documentacion pesada: se comparten aparte, no por el repo
*.pdf
*.pptx
*.xlsx


*.md
!README.md
